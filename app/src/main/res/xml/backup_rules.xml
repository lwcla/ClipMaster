<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ResourceName">
    <!-- WebDAV 密码、备份目录授权和备份健康状态属于设备绑定/敏感配置，不应被系统 Auto Backup 搬到新安装中。 -->
    <exclude
        domain="file"
        path="mmkv/" />
    <!-- Shizuku Provider 图标传输目录只保存 content write 的临时 PNG，不具备跨安装恢复意义。 -->
    <exclude
        domain="file"
        path="clipboard_bridge_icons/" />
    <!-- Shizuku Provider 剪贴 payload 传输目录可能短暂保存敏感文本，只用于单次 commit_clip，不具备跨安装恢复意义。 -->
    <exclude
        domain="file"
        path="clipboard_bridge_clip_payloads/" />
    <!-- TorrentSearch 独立数据库含书签、搜索历史和 magnet 快照，必须只经后续字段白名单自定义备份。 -->
    <exclude
        domain="database"
        path="torrent_search_feature.db" />
    <!-- TorrentSearch DataStore 含本机 Provider 与安全模式选择，禁止系统 Auto Backup 整文件恢复。 -->
    <exclude
        domain="file"
        path="datastore/torrent_search_settings.preferences_pb" />
    <!-- Torznab API Key 只保存 Android Keystore 认证密文，跨安装恢复后不可解且不得上传云端。 -->
    <exclude
        domain="sharedpref"
        path="torrent_search_torznab_secrets.xml" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
