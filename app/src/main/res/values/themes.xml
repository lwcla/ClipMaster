    <style name="Theme.ClipMaster" parent="android:style/Theme.Material.NoActionBar" tools:ignore="ResourceName">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/host_brand_primary</item>
