<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ResourceName">
    <!-- WebDAV 密码、备份目录授权和备份健康状态属于设备绑定/敏感配置，不应被系统 Auto Backup 搬到新安装中。 -->
    <exclude
        domain="file"
        path="mmkv/" />
    <!-- Shizuku Provider 图标传输目录只保存 content write 的临时 PNG，不具备跨安装恢复意义。 -->
    <exclude
        domain="file"
        path="clipboard_bridge_icons/" />
    <!-- Shizuku Provider 剪贴 payload 传输目录可能短暂保存敏感文本，只用于单次 commit_clip，不具备跨安装恢复意义。 -->
    <exclude
        domain="file"
        path="clipboard_bridge_clip_payloads/" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
