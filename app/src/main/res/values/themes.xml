<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础主题只声明 minSdk 24 可用属性，API 27+ 差异项放到 values-v27 覆盖。 -->
    <style name="Theme.ClipMaster.Base" parent="android:style/Theme.Material.NoActionBar" tools:ignore="ResourceName">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/host_brand_primary</item>
    </style>

    <!-- Manifest 使用的主题名保持稳定，便于高版本资源只覆盖差异项。 -->
    <style name="Theme.ClipMaster" parent="Theme.ClipMaster.Base" tools:ignore="ResourceName" />

    <!-- Shizuku 唤醒页使用的 NoDisplay 主题，只用于冷启动主进程，不创建可见窗口或业务 UI。 -->
    <style name="Theme.ClipMaster.ShizukuWakeNoDisplay" parent="android:style/Theme.NoDisplay" tools:ignore="ResourceName" />
</resources>
