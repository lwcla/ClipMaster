<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ResourceName">
    <cloud-backup>
        <!-- WebDAV 密码、备份目录授权和备份健康状态属于设备绑定/敏感配置，不应由系统云备份自动恢复。 -->
        <exclude
            domain="file"
            path="mmkv/" />
        <!-- Shizuku Provider 图标传输目录只保存临时 PNG，恢复后无法复用且会被下一次调用清理。 -->
        <exclude
            domain="file"
            path="clipboard_bridge_icons/" />
        <!-- Shizuku Provider 剪贴 payload 传输目录可能短暂保存敏感文本，恢复后无意义且存在隐私风险。 -->
        <exclude
            domain="file"
            path="clipboard_bridge_clip_payloads/" />
        <!-- TorrentSearch 数据库只允许后续自定义字段白名单备份，禁止系统云端整库恢复。 -->
        <exclude
            domain="database"
            path="torrent_search_feature.db" />
        <!-- TorrentSearch DataStore 含本机来源和安全模式状态，禁止系统云备份。 -->
        <exclude
            domain="file"
            path="datastore/torrent_search_settings.preferences_pb" />
        <!--
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <!-- Shizuku Provider 图标传输目录只保存临时 PNG，设备迁移后不应恢复。 -->
        <exclude
            domain="file"
            path="clipboard_bridge_icons/" />
        <!-- Shizuku Provider 剪贴 payload 传输目录只用于单次敏感文本提交，设备迁移后不应恢复。 -->
        <exclude
            domain="file"
            path="clipboard_bridge_clip_payloads/" />
        <!-- 设备迁移也不得整库复制 TorrentSearch 用户内容，应走显式恢复报告。 -->
        <exclude
            domain="database"
            path="torrent_search_feature.db" />
        <!-- 设备迁移不继承本机 Provider 与安全模式选择。 -->
        <exclude
            domain="file"
            path="datastore/torrent_search_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
