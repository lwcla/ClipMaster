<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ResourceName">
    <cloud-backup>
        <!-- 仅排除已由 GMA 1.4.0 / UMP 4.0.0 字节码核实的广告专用偏好；不排除应用默认偏好或其他业务文件。 -->
        <exclude domain="sharedpref" path="__GOOGLE_FUNDING_CHOICE_SDK_INTERNAL__.xml" />
        <exclude domain="sharedpref" path="GoogleMobileAds.xml" />
        <exclude domain="sharedpref" path="pcvmspf2.xml" />
        <exclude domain="sharedpref" path="paid_storage_sp.xml" />

        <!-- WebDAV 密码、备份目录授权和备份健康状态属于设备绑定/敏感配置，不应由系统云备份自动恢复。 -->
        <exclude
            domain="file"
            path="mmkv/" />
        <!-- Shizuku Provider 图标传输目录只保存临时 PNG，恢复后无法复用且会被下一次调用清理。 -->
        <exclude
            domain="file"
            path="clipboard_bridge_icons/" />
        <!-- Shizuku Provider 剪贴 payload 传输目录可能短暂保存敏感文本，恢复后无意义且存在隐私风险。 -->
        <exclude
            domain="file"
            path="clipboard_bridge_clip_payloads/" />
        <!-- TorrentSearch 数据库只允许后续自定义字段白名单备份，禁止系统云端整库恢复。 -->
        <exclude
            domain="database"
            path="torrent_search_feature.db" />
        <!-- SQLite 运行时 sidecar 与主库一起排除，防止备份窗口复制 WAL/SHM/journal。 -->
        <exclude domain="database" path="torrent_search_feature.db-wal" />
        <exclude domain="database" path="torrent_search_feature.db-shm" />
        <exclude domain="database" path="torrent_search_feature.db-journal" />
        <!-- TorrentSearch DataStore 含本机来源和安全模式状态，禁止系统云备份。 -->
        <exclude
            domain="file"
            path="datastore/torrent_search_settings.preferences_pb" />
        <!-- Torznab 设备绑定密文不得由系统云备份恢复。 -->
        <exclude
            domain="sharedpref"
            path="torrent_search_torznab_secrets.xml" />
        <!-- Cloudflare WebView Cookie 与挑战状态不上传系统云备份。 -->
        <exclude
            domain="root"
            path="app_webview/" />
        <!--
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <!-- 仅排除已由 GMA 1.4.0 / UMP 4.0.0 字节码核实的广告专用偏好；不排除应用默认偏好或其他业务文件。 -->
        <exclude domain="sharedpref" path="__GOOGLE_FUNDING_CHOICE_SDK_INTERNAL__.xml" />
        <exclude domain="sharedpref" path="GoogleMobileAds.xml" />
        <exclude domain="sharedpref" path="pcvmspf2.xml" />
        <exclude domain="sharedpref" path="paid_storage_sp.xml" />

        <!-- Shizuku Provider 图标传输目录只保存临时 PNG，设备迁移后不应恢复。 -->
        <exclude
            domain="file"
            path="clipboard_bridge_icons/" />
        <!-- Shizuku Provider 剪贴 payload 传输目录只用于单次敏感文本提交，设备迁移后不应恢复。 -->
        <exclude
            domain="file"
            path="clipboard_bridge_clip_payloads/" />
        <!-- 设备迁移也不得整库复制 TorrentSearch 用户内容，应走显式恢复报告。 -->
        <exclude
            domain="database"
            path="torrent_search_feature.db" />
        <!-- 设备迁移也排除 SQLite sidecar，避免与新安装主库形成不一致组合。 -->
        <exclude domain="database" path="torrent_search_feature.db-wal" />
        <exclude domain="database" path="torrent_search_feature.db-shm" />
        <exclude domain="database" path="torrent_search_feature.db-journal" />
        <!-- 设备迁移不继承本机 Provider 与安全模式选择。 -->
        <exclude
            domain="file"
            path="datastore/torrent_search_settings.preferences_pb" />
        <!-- 设备迁移同样排除无法由新设备 Keystore 解开的 Torznab 密文。 -->
        <exclude
            domain="sharedpref"
            path="torrent_search_torznab_secrets.xml" />
        <!-- 设备迁移不复制 Cloudflare WebView Cookie 与挑战状态。 -->
        <exclude
            domain="root"
            path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
